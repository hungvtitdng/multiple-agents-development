# Riêng máy này (copy thành .claude/agent-team.local.config, đã gitignore, KHÔNG commit).
# Key ở đây ghi đè .claude/agent-team.config (config chung của team) cho: pool.py, progress.py, board.py, guard, agent-db.sh.
# Không ghi password / KEY ở đây: KEY để trong .env.

# Tên viết tắt của bạn: thêm vào task-id (YYYYMMDD-<DEV_ID>-<slug>) và cột "Người chạy" của bảng Module
DEV_ID=
# Số task chạy cùng lúc trên máy này (theo quota gói Claude + RAM máy). Trống = config chung / mặc định 8
MAX_PARALLEL=
# Số module debate cùng lúc. Trống = config chung / mặc định 4
MAX_DEBATE=
# Cổng E2E đầu tiên cho worktree (đổi nếu 2 người chạy trên cùng 1 máy)
E2E_PORT_BASE=
# Phút im lặng coi là agent treo
HANG_MINUTES=
# Status line: table | 1
PROGRESS_LINES=

# /agent-team:tasks lấy ticket từ đâu: jira | github | file (tự ghi .agent-team/tickets/<mã>.md).
# Để trống: có JIRA_TOKEN trong .claude/agent-team.secret thì tự hiểu là jira. Jira / GitHub không cần cấu hình gì thêm.
TICKET_SOURCE=
# Chỉ đặt khi muốn đổi lệnh mặc định (vd lọc theo sprint) hoặc dùng nguồn khác. {id} = mã ticket; dùng được $KEY của agent-team.secret.
# Lệnh không được kết thúc bằng dấu nháy. Token KHÔNG ghi vào file này.
#   TICKET_LIST_CMD=curl -sfG "$JIRA_URL/rest/api/3/search/jql" --data-urlencode "jql=assignee = currentUser() AND sprint in openSprints() AND statusCategory = 'To Do'" --data-urlencode "fields=key" -u "$JIRA_EMAIL:$JIRA_TOKEN" --max-time 20
TICKET_CMD=
TICKET_LIST_CMD=
