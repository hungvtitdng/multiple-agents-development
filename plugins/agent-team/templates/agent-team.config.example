# Agent team config cho project. KHÔNG ghi password/KEY vào file này.

BASE_BRANCH=develop
# 1 = có remote: fetch + push branch task/*. 0 = repo chỉ ở máy (dự án mới chưa có remote): không fetch/push.
PUSH=1
# Repo nào có nhánh gốc khác BASE_BRANCH thì ghi ở đây (repo=nhánh, cách nhau bằng dấu cách). Chỉ cần khi có REPOS.
# Ví dụ: BASE_BRANCH=main  BASE_BRANCHES="../FrontEnd=master"
BASE_BRANCHES=

# Nhiều repo: file này nằm trong repo chính ("."). Liệt kê repo chính + repo khác (đường dẫn từ repo chính).
# Mở Claude Code ở repo chính, thêm repo còn lại bằng /add-dir.
# Ví dụ: REPOS=". ../FrontEnd"  BE_PATHS="app lib"  FE_PATHS="../FrontEnd"  TEST_PATHS="spec ../FrontEnd/e2e"
# Để trống = 1 repo (chạy như cũ). Các đường dẫn bên dưới tính từ repo chính.
REPOS=

# Đường dẫn code (guard dùng để khóa: dev chỉ sửa BE/FE của mình, Tester chỉ sửa test)
BE_PATHS="app lib config db/migrate"
FE_PATHS="frontend"
TEST_PATHS="spec test e2e"
# Thư mục mock duy nhất (FE dựng trước khi BE xong). Nằm trong FE_PATHS (FE tách) hoặc BE_PATHS (BE render view). Sổ: MOCKS.md
MOCK_PATHS="frontend/src/mocks"

# Lệnh lint/format (init tự nhận diện). Dev chạy trước khi commit; Lead chỉ sang S5 khi pass. Để trống = bỏ qua.
LINT_CMD=
FORMAT_CMD=

# Responsive: các chiều rộng màn hình (px) phải dùng được. Chỉ máy tính: "1280". Có điện thoại: "375 768 1280".
# Wireframe vẽ tab Mobile, test case + E2E chạy đủ từng chiều rộng, code-reviewer kiểm.
VIEWPORTS="375 768 1280"

# ---- E2E trình duyệt (Playwright), chạy bằng agent-db.sh e2e <task-id> trên DB riêng của task ----
# Để trống E2E_CMD = dự án chưa có E2E (task có UI vẫn phải có, xem release-notes).
# Lệnh có dấu $ thì để trong nháy ĐƠN ('...'), vì file này được nạp bằng shell.
# full = mỗi task chạy E2E · mvp = task chỉ test BE + component, E2E: DEFER, chạy toàn bộ sau ở M-E2E (ship MVP nhanh)
TEST_MODE=full
# E2E_WAIT=120            # số giây chờ app lên trước khi chạy E2E
# Test component / unit FE (vd "npx vitest run"), chạy bằng agent-db.sh fe-test <task-id> [args]. TEST_MODE=mvp cần lệnh này.
FE_TEST_CMD=
E2E_CMD=                    # vd "npx playwright test", chạy trên máy (host), nhận BASE_URL, VIEWPORTS, EVIDENCE_DIR
APP_START_CMD=              # vd "bin/rails s -b 0.0.0.0 -p 3000", chạy trong container APP_SERVICE, nối DB riêng của task; server phải phục vụ song song (PHP: "PHP_CLI_SERVER_WORKERS=8 php -S ..."), build FE 1 lần
APP_PORT=3000               # cổng app trong container
E2E_PORT=3999               # cổng mở ra máy cho E2E (khác cổng app đang chạy để không đụng nhau)
# FE tách riêng (SPA): lệnh chạy FE trên máy, nhận API_URL=http://localhost:$E2E_PORT; E2E dùng E2E_FE_URL
E2E_FE_START_CMD=
E2E_FE_URL=

# Duyệt cấu hình: CHỈ user tự ghi `ok` sau khi đọc bảng cấu hình init in ra (hook chặn gọi agent khi còn trống, chặn Lead tự ghi).
# Config cũ không có dòng này thì không bị chặn.
CONFIG_APPROVED=

# Kiểu response API: flat (mặc định) = BE chỉ đọc + lọc theo quyền rồi trả dữ liệu thô, FE tự tính · cooked = BE tính toán / gộp rồi trả
# (tổng, gom nhóm, định dạng). flat: mỗi API ghi PHẲNG / XỬ LÝ trong API contract (quy tắc ở agents/solution-architect.md).
API_RESPONSE=flat

# Mức model: economy | standard | max (mặc định standard). Lead chọn model theo bảng trong run.md mục 2.
COST_TIER=standard

# Nơi Lead ghi bài học sau mỗi task (Scout đọc ở task sau). Để trống = bỏ qua.
LESSONS_PATH=docs/LESSONS.md

# Agent im lặng (không dùng tool) quá số phút này thì coi là treo: board.py wait / status / status line báo ⚠.
# Lệnh có `timeout N` thì ngưỡng theo N. Việc chạy lâu mà vẫn dùng tool (vẽ nhiều màn) không bị coi là treo.
HANG_MINUTES=10
# Status line: 1 = một dòng (mặc định, không chiếm terminal), table = bảng nhiều dòng. Bảng đầy đủ luôn ghi vào .agent-team/STATUS.md (mở preview để xem)
PROGRESS_LINES=1
# App: auto = 1 người chạy hết Phase A-D · manual = team: dừng sau Phase B (bàn giao), mỗi người /agent-team:task M-n
APP_BUILD=auto
# Tạo DB mới + dữ liệu mẫu cho test / E2E (Phase B bàn giao; máy nào cũng chạy được), vd "php artisan migrate:fresh --seed"
SEED_CMD=
# Tài liệu schema: mục `## Bảng` (tên bảng trong backtick ở cột đầu). pool.py schema / fill kiểm mọi bảng có migration (M-DB)
SCHEMA_DOC=docs/database/schema.md
# Điều phối (App / Module, pool.py): số slot cho cả app = task code + debate module. Đổi lúc nào cũng được (tự scale)
MAX_PARALLEL=8
# /agent-team:tasks: chế độ quyền của phiên Claude nền (số task cùng lúc = MAX_PARALLEL; nguồn ticket: agent-team.local.config)
BATCH_PERMISSION=auto
# Số module debate cùng lúc (mỗi debate 1 slot), module khác chờ
MAX_DEBATE=4
# Merge + integration test chạy quá số phút này thì status line hiện ⚠
MERGE_WARN_MINUTES=20
# Thư mục worktree của task (tự thêm vào .git/info/exclude)
WORKTREE_DIR=.worktrees
# Cổng E2E của worktree: E2E_PORT_BASE, +1, +2... (không đụng nhau khi chạy song song)
E2E_PORT_BASE=4000
# Chạy sau mỗi lần merge task về branch phiên (trống = TEST_CMD + agent-db.sh e2e toàn bộ)
INTEGRATION_CMD=

# 1 = dùng code graph Graphify (cài riêng: xem release-notes của plugin; Lead chạy graphify update)
USE_CODE_GRAPH=1

# Chỉ mục hàm docs/functions/<model>.md: thư mục có hàm public cần ghi nghĩa (service, repository, model...).
# kb-check.py so với graph: hàm public ở đây chưa có dòng → thiếu. Để trống = không dùng chỉ mục hàm.
# Ví dụ: FUNCTION_INDEX_PATHS="app/services app/models app/repositories"  (nhiều repo: "../FrontEnd/src/services")
FUNCTION_INDEX_PATHS=

# ---- Docker / DB riêng của task ----
# Thư mục chứa docker-compose (tính từ thư mục có .claude/, vd "be"). Để trống = thư mục đó.
COMPOSE_DIR=
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=

DB_ENGINE=postgres          # postgres | mysql
DB_SERVICE=db               # tên service DB trong docker compose
DB_NAME=app_development     # DB cần clone
APP_SERVICE=app             # service để chạy migrate / test

# Migration: CHỈ sinh file bằng generator của framework, chạy trong container app (không tự tạo file, tránh trùng timestamp)
MIGRATION_PATHS="db/migrate"                        # thư mục chứa migration (guard chặn tạo file mới bằng tay ở đây)
MIGRATION_GEN_CMD="bin/rails generate migration"    # agent-db.sh generate <task-id> <Tên> [field:type...]
MIGRATION_GEN_USER=                                 # trống = user mặc định của container; "host" = uid:gid của máy (tránh file thuộc root)
MIGRATE_CMD="bin/rails db:migrate"
ROLLBACK_CMD="bin/rails db:rollback STEP=1"
TEST_CMD="bundle exec rspec"

# CLONE_MODE: container = mỗi task 1 container DB sao chép (cũ) · schema = 1 container DB + 1 container app cho mọi worktree:
#   DB riêng mỗi task <DB_NAME>_<task> (migrate + SEED_CMD), lệnh chạy bằng `docker compose exec -w <thư mục worktree>`.
#   Compose: app mount `./:/var/www/main`, `./.worktrees:/var/www/.worktrees`, volume rỗng `/var/www/main/.worktrees` (main không thấy worktree), publish sẵn 100 cổng 8800-8899 (main :8800, worktree :8801, :8802..., E2E_PORT_BASE mặc định 8801).
#   APP_START_CMD dùng {port}, vd "PHP_CLI_SERVER_WORKERS=8 php -S 0.0.0.0:{port} -t public"
CLONE_MODE=container
CONTAINER_MAIN=/var/www/main
CONTAINER_WT=/var/www/.worktrees
SCHEMA_ENV="DB_DATABASE={db}"                           # env riêng của task: {db} = DB riêng, {task} = mã task
# Service khác dùng chung container, tách bằng prefix, vd Laravel:
# SCHEMA_ENV="DB_DATABASE={db} REDIS_PREFIX={task}_ CACHE_PREFIX={task}_ SCOUT_PREFIX={task}_ QUEUE_CONNECTION=sync MAIL_MAILER=log"
SCHEMA_DOWN_CMD=                                        # dọn dữ liệu service của task khi xong, vd "php artisan cache:clear" (có {task})
SHARED_DEPS="vendor:composer.lock node_modules:package-lock.json"  # mỗi worktree 1 bản riêng (clone APFS / reflink từ thư mục chính, lock khác thì cài lại)
# Theo stack (bảng đầy đủ ở init.md): Rails "node_modules:yarn.lock" (+ "vendor/bundle:Gemfile.lock") · Go để trống (có vendor/: "vendor:go.sum") · Node "node_modules:<lock>"

# Biến env app dùng để trỏ tới DB riêng của task. Placeholder: {host} {port} {user} {password} {db} {url}
CLONE_ENV="DATABASE_URL={url}"
# Ví dụ app dùng biến rời:
# CLONE_ENV="DB_HOST={host} DB_PORT={port} DB_USERNAME={user} DB_PASSWORD={password} DB_NAME={db}"
